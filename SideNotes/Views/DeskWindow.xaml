<Window x:Class="SideNotes.Views.DeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SideNotes — Desk"
        Width="24"
        Height="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Loaded="Window_Loaded"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="DeskRoot">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#31544B"
                        Cursor="Hand"
                        AutomationProperties.Name="Fechar nota no Desk"/>

                <TextBox Grid.Row="1"
                         Text="{Binding Title,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         FontSize="19"
                         FontWeight="SemiBold"
                         Foreground="#242A28"
                         Background="Transparent"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         MaxHeight="90"
                         VerticalScrollBarVisibility="Hidden"
                         Margin="0,4,0,12"
                         AutomationProperties.Name="Título da nota"/>

                <TextBox Grid.Row="2"
                         Text="{Binding Content,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Foreground="#343B37"
                         Background="Transparent"
                         Padding="0"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Hidden"
                         HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Conteúdo da nota"/> 
            </Grid>

        <!-- Abas das notas fixadas -->
        <ItemsControl x:Name="NoteTabs"
                      ItemsSource="{Binding DeskNotes}"
                      Visibility="Collapsed"
                      Width="248"
                      Height="400"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      ClipToBounds="False">

            <ItemsControl.RenderTransform>
                <TranslateTransform/>
            </ItemsControl.RenderTransform>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="False"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Panel.ZIndex" Value="0"/>
                    <Setter Property="ClipToBounds" Value="False"/>

                    <EventSetter Event="Loaded"
                                 Handler="NoteContainer_Loaded"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="100"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="240"
                          Height="160"
                          ClipToBounds="False">

                        <Border x:Name="NoteCard"
                                Width="40"
                                Height="144"
                                VerticalAlignment="Top"
                                HorizontalAlignment="{Binding HorizontalAlignment,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Background="{Binding Color}"
                                CornerRadius="8"
                                BorderBrush="#20000000"
                                BorderThickness="1"
                                Cursor="Hand"
                                MouseLeftButtonDown="NoteTab_MouseLeftButtonDown"
                                RenderTransformOrigin="0.5,0.5">

                            <Border.Effect>
                                <DropShadowEffect Color="#000000"
                                                  BlurRadius="10"
                                                  ShadowDepth="2"
                                                  Opacity="0.16"/>
                            </Border.Effect>

                            <Border.RenderTransform>
                                <RotateTransform
                                    Angle="{Binding Tag,
                                    RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
                            </Border.RenderTransform>

                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Identificação vertical da nota. -->
                                <Grid Grid.Column="0">
                                    <TextBlock x:Name="TabTitle"
                                               Text="{Binding Title}"
                                               Width="48"
                                               Margin="0,8,0,0"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               Foreground="#A6222826"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top">

                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="-90"/>
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>

                                    <!-- Divisória semelhante à de uma aba de papel. -->
                                    <Line x:Name="TabDivider"
                                          X1="0"
                                          Y1="0"
                                          X2="0"
                                          Y2="1"
                                          Stretch="Fill"
                                          Width="1"
                                          Margin="0,10,0,10"
                                          HorizontalAlignment="Right"
                                          Stroke="#30222826"
                                          StrokeThickness="1"
                                          StrokeDashArray="3,3"
                                          Visibility="Collapsed"
                                          IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Prévia do conteúdo. -->
                                <Grid x:Name="NotePreview"
                                      Grid.Column="1"
                                      Margin="14,16,16,14"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False"
                                      ClipToBounds="True">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Title}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#242A28"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Content}"
                                               FontSize="13"
                                               LineHeight="19"
                                               Foreground="#C7242A28"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <DataTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver,
                                                     ElementName=NoteCard}"
                                           Value="True"/>
                            </MultiDataTrigger.Conditions>

                            <Setter TargetName="NoteCard"
                                    Property="Width"
                                    Value="240"/>

                            <Setter TargetName="NoteCard"
                                    Property="Height"
                                    Value="160"/>

                            <Setter TargetName="NoteCard"
                                    Property="BorderBrush"
                                    Value="#30000000"/>

                            <Setter TargetName="TabDivider"
                                    Property="Visibility"
                                    Value="Visible"/>

                            <Setter TargetName="NotePreview"
                                    Property="Visibility"
                                    Value="Visible"/>

                            <Setter TargetName="TabTitle"
                                    Property="Width"
                                    Value="128"/>

                            <Setter TargetName="NoteCard"
                                    Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#000000"
                                                      BlurRadius="12"
                                                      ShadowDepth="3"
                                                      Opacity="0.20"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Área de arraste um pouco maior que a pílula -->
        <!-- Área de clique e arraste da pílula. -->
        <Border x:Name="PillHandle"
                Width="24"
                Padding="5,8"
                Background="Transparent"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Cursor="SizeAll"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                MouseRightButtonDown="Pill_MouseRightButtonDown"
                MouseRightButtonUp="Pill_MouseRightButtonUp"
                MouseMove="Pill_MouseMove"
                LostMouseCapture="Pill_LostMouseCapture"
                ContextMenuService.IsEnabled="False"
                AutomationProperties.Name="Notas fixadas no Desk">

            <Border CornerRadius="7"
                    MinHeight="36"
                    Padding="3,5"
                    BorderThickness="1">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="#B3272B30"/>

                        <Setter Property="BorderBrush"
                                Value="#40FFFFFF"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver,
                                                ElementName=PillHandle}"
                                         Value="True">

                                <Setter Property="Background"
                                        Value="#E033383F"/>

                                <Setter Property="BorderBrush"
                                        Value="#70FFFFFF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ItemsControl ItemsSource="{Binding DeskNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="6"
                                    Height="12"
                                    CornerRadius="3"
                                    Background="{Binding Color}"
                                    Margin="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Border>
    </Grid>
</Window>