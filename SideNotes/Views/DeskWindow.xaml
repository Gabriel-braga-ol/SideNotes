<Window x:Class="SideNotes.Views.DeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SideNotes — Desk"
        Width="24"
        Height="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Loaded="Window_Loaded"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Grid x:Name="DeskRoot">

        <!-- Abas das notas fixadas -->
        <ItemsControl x:Name="NoteTabs"
                      ItemsSource="{Binding DeskNotes}"
                      Visibility="Collapsed"
                      Width="64"
                      Margin="0,0,24,28"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- A altura menor que a aba cria a sobreposição -->
                    <Grid Height="66">
                        <Border Height="92"
                                VerticalAlignment="Top"
                                Background="{Binding Color}"
                                CornerRadius="12"
                                BorderBrush="#18000000"
                                BorderThickness="1"
                                ToolTip="{Binding Title}">

                            <TextBlock Text="{Binding Title}"
                                       Width="64"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#31544B"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Área de arraste um pouco maior que a pílula -->
        <Border x:Name="PillHandle"
                Width="24"
                Padding="6,8"
                Background="Transparent"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Cursor="SizeAll"
                ToolTip="Arraste para mudar de lado ou de altura"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown">

            <Border Background="#99727884"
                    CornerRadius="6"
                    MinHeight="36"
                    Padding="3,5">

                <ItemsControl ItemsSource="{Binding DeskNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="6"
                                    Height="13"
                                    CornerRadius="3"
                                    Background="{Binding Color}"
                                    Margin="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Border>
    </Grid>
</Window>