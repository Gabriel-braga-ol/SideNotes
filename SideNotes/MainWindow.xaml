<Window x:Class="SideNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SideNotes"
        mc:Ignorable="d"
        Title="SideNotes"
        Height="680"
        Width="1000"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#F5F6F8"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de notas -->
        <Border Grid.Column="0"
                Background="Transparent"
                Margin="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="+ Nova nota"
                        Height="40"
                        Margin="0,0,0,12"
                        FontSize="14"
                        Click="AddNote_Click"/>

                <ListBox x:Name="NotesList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding Content}"
                                           FontSize="12"
                                           Opacity="0.75"
                                           Margin="0,6,0,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="72"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="{Binding Color}"/>
                            <Setter Property="Foreground" Value="#1E3A34"/>
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="NoteItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="12"
                                                Padding="12">
                                            <ContentPresenter
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter TargetName="NoteItemBorder"
                                                        Property="BorderBrush"
                                                        Value="#31544B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Editor da nota selecionada -->
        <Border x:Name="NotePanel"
                Grid.Column="1"
                Background="{Binding SelectedNote.Color,
                                     TargetNullValue=Transparent,
                                     FallbackValue=Transparent}"
                CornerRadius="18"
                Margin="0,12,12,12"
                Padding="24">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="IsEnabled" Value="True"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedNote}"
                         Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="TitleTextBox"
                         Grid.Row="0"
                         Text="{Binding SelectedNote.Title,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged,
                                        TargetNullValue='',
                                        FallbackValue=''}"
                         FontSize="24"
                         TextWrapping="NoWrap"
                         FontWeight="SemiBold"
                         Foreground="#1E3A34"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,0,20"/>

                <TextBox x:Name="ContentTextBox"
                         Grid.Row="1"
                         Text="{Binding SelectedNote.Content,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged,
                                        TargetNullValue='',
                                        FallbackValue=''}"
                         FontSize="16"
                         Foreground="#31544B"
                         Background="Transparent"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>