<Window x:Class="DearNotes.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DearNotes"
        mc:Ignorable="d"
        Title="DearNotes"
        Height="680"
        Width="1000"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de notas -->
        <Border Grid.Column="0"
                Background="Transparent"
                Margin="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="+ Nova nota"
                        Height="42"
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="{StaticResource AccentBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding CreateNoteCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="{StaticResource AccentPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Row="1"
                            Margin="0,0,0,12">
                    <TextBlock Text="Buscar notas"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,6"/>

                    <Border Background="White"
                            CornerRadius="8"
                            BorderThickness="1"
                            Padding="10,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>

                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBox Text="{Binding SearchText,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Buscar por título ou conteúdo"
                                 AutomationProperties.Name="Buscar notas"/>
                    </Border>
                </StackPanel>

                <ListBox x:Name="NotesList"
                         Grid.Row="2"
                         FocusVisualStyle="{x:Null}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ItemsSource="{Binding FilteredNotes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding Content}"
                                           FontSize="12"
                                           Opacity="0.75"
                                           Margin="0,6,0,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="72"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="{Binding Color}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="NoteItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="12"
                                                Padding="12">
                                            <ContentPresenter
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter TargetName="NoteItemBorder"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="Nenhuma nota encontrada"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,24,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=NotesList,
                                               Path=HasItems}"
                             Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </Grid>
        </Border>

        <!-- Editor da nota selecionada -->
        <Border x:Name="NotePanel"
                Grid.Column="1"
                Background="{Binding SelectedNote.Color,
                                     TargetNullValue=Transparent,
                                     FallbackValue=Transparent}"
                CornerRadius="18"
                Margin="0,12,12,12"
                Padding="24">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="IsEnabled" Value="True"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedNote}"
                         Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="TitleTextBox"
                         Grid.Row="0"
                         Text="{Binding SelectedNote.Title,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged,
                                        TargetNullValue='',
                                        FallbackValue=''}"
                         FontSize="24"
                         TextWrapping="NoWrap"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,0,0,20"/>

                <TextBox x:Name="ContentTextBox"
                         Grid.Row="1"
                         Text="{Binding SelectedNote.Content,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged,
                                        TargetNullValue='',
                                        FallbackValue=''}"
                         FontSize="16"
                         Foreground="{StaticResource AccentBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Hidden"/>

                <Button Grid.Row="2"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Cursor="Hand"
                        Command="{Binding ToggleDeskPinCommand}">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource PinBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PinIconBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="ToolTip" Value="Fixar no Desk"/>
                            <Setter Property="AutomationProperties.Name"
                    Value="Fixar no Desk"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNote.IsPinnedToDesk}"
                                             Value="True">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource PinIconActiveBrush}"/>
                                    <Setter Property="ToolTip" Value="Desafixar do Desk"/>
                                    <Setter Property="AutomationProperties.Name"
                                            Value="Desafixar do Desk"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding SelectedNote}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Circle"
                                    CornerRadius="20"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">

                                <Viewbox Width="21"
                                         Height="21"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="PinIcon"
                                              Data="M 9,3 L 15,3 L 14,9 L 17,13
                                                    L 17,15 L 7,15 L 7,13 L 10,9 Z
                                                    M 12,15 L 12,21"
                                              Fill="Transparent"
                                              Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="35"
                                                                 CenterX="12"
                                                                 CenterY="12"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Circle"
                                            Property="Background"
                                            Value="{StaticResource PinHoverBackgroundBrush}"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Circle"
                                            Property="Opacity"
                                            Value="0.7"/>
                                </Trigger>

                                <DataTrigger Binding="{Binding SelectedNote.IsPinnedToDesk}"
                                             Value="True">
                                    <Setter TargetName="PinIcon"
                                            Property="Fill"
                                            Value="{StaticResource PinIconActiveBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <TextBlock Grid.Column="1"
           Text="Selecione ou crie uma nota"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="18"
           Foreground="{StaticResource TextMutedBrush}"
           IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedNote}"
                             Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>