<Window x:Class="DearNotes.Views.DeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DearNotes — Desk"
        Width="36"
        Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Loaded="Window_Loaded"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="DeskRoot"
          Background="Transparent"
          KeyboardNavigation.TabNavigation="Cycle">

        <!-- Leque: cartas sobrepostas como telhas, cada uma com a aba vertical da nota. -->
        <ItemsControl x:Name="FanCards"
                      ItemsSource="{Binding DeskNotes}"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      KeyboardNavigation.TabIndex="1"
                      ClipToBounds="False">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="False"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Panel.ZIndex" Value="0"/>
                    <Setter Property="ClipToBounds" Value="False"/>

                    <EventSetter Event="Loaded"
                                 Handler="NoteContainer_Loaded"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="100"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Panel.ZIndex" Value="100"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="NoteCard"
                            Background="{Binding Color}"
                            CornerRadius="14"
                            BorderBrush="{StaticResource NoteCardBorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Focusable="True"
                            FocusVisualStyle="{x:Null}"
                            KeyDown="NoteTab_KeyDown"
                            AutomationProperties.Name="{Binding Title}"
                            AutomationProperties.HelpText="Pressione Enter para abrir a nota e Escape para recolher o Desk."
                            MouseLeftButtonDown="NoteTab_MouseLeftButtonDown">

                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource ShadowColor}"
                                              Direction="315"
                                              BlurRadius="16"
                                              ShadowDepth="4"
                                              Opacity="0.20"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Aba vertical com o nome da nota. -->
                            <Grid Grid.Column="0"
                                  ClipToBounds="True">

                                <Border Width="1"
                                        Margin="0,10"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource NoteTabDividerBrush}"/>

                                <Grid Height="64"
                                      Margin="0,4,0,0"
                                      VerticalAlignment="Top">

                                    <TextBlock Width="56"
                                               Text="{Binding Title}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource NoteTabTitleBrush}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">

                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Grid>

                            <!-- Corpo da nota: título e prévia. -->
                            <Grid Grid.Column="1"
                                  Margin="16,14,18,14"
                                  ClipToBounds="True">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextStrongBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Content}"
                                           FontSize="12.5"
                                           LineHeight="18"
                                           Foreground="{StaticResource NotePreviewTextBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver,
                                                     ElementName=NoteCard}"
                                     Value="True">

                            <Setter TargetName="NoteCard"
                                    Property="BorderBrush"
                                    Value="{StaticResource NoteCardActiveBorderBrush}"/>

                            <Setter TargetName="NoteCard"
                                    Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource ShadowColor}"
                                                      Direction="315"
                                                      BlurRadius="22"
                                                      ShadowDepth="7"
                                                      Opacity="0.26"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsKeyboardFocused,
                                                     ElementName=NoteCard}"
                                     Value="True">

                            <Setter TargetName="NoteCard"
                                    Property="BorderBrush"
                                    Value="{StaticResource NoteCardFocusBorderBrush}"/>

                            <Setter TargetName="NoteCard"
                                    Property="BorderThickness"
                                    Value="2"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Baralho recolhido: abas coloridas empilhadas acima do botão de nova nota. -->
        <StackPanel x:Name="TabDeck"
                    Width="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,46"
                    Background="Transparent"
                    Cursor="SizeAll"
                    Focusable="True"
                    FocusVisualStyle="{x:Null}"
                    KeyDown="DeskHandle_KeyDown"
                    KeyboardNavigation.TabIndex="0"
                    AutomationProperties.Name="Notas fixadas no Desk"
                    AutomationProperties.HelpText="Aproxime o ponteiro para abrir o leque ou pressione Enter.">

            <ItemsControl x:Name="NoteTabs"
                          ItemsSource="{Binding DeskNotes}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="DeskTab"
                                Width="34"
                                Height="92"
                                Margin="0,0,0,6"
                                Background="{Binding Color}"
                                CornerRadius="10"
                                BorderBrush="{StaticResource DeskTabBorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Focusable="True"
                                FocusVisualStyle="{x:Null}"
                                KeyDown="DeskTab_KeyDown"
                                AutomationProperties.Name="{Binding Title}"
                                AutomationProperties.HelpText="Pressione Enter para abrir a nota."
                                MouseLeftButtonDown="DeskTab_MouseLeftButtonDown">

                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowColor}"
                                                  Direction="180"
                                                  BlurRadius="10"
                                                  ShadowDepth="2"
                                                  Opacity="0.20"/>
                            </Border.Effect>

                            <Grid ClipToBounds="True">

                                <Border Width="1"
                                        Margin="0,10"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource NoteTabDividerBrush}"/>

                                <TextBlock Width="76"
                                           Text="{Binding Title}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NoteTabTitleBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">

                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver,
                                                         ElementName=DeskTab}"
                                         Value="True">

                                <Setter TargetName="DeskTab"
                                        Property="BorderBrush"
                                        Value="{StaticResource DeskTabHoverBorderBrush}"/>

                                <Setter TargetName="DeskTab"
                                        Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{StaticResource ShadowColor}"
                                                          Direction="180"
                                                          BlurRadius="14"
                                                          ShadowDepth="3"
                                                          Opacity="0.26"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsKeyboardFocused,
                                                         ElementName=DeskTab}"
                                         Value="True">

                                <Setter TargetName="DeskTab"
                                        Property="BorderBrush"
                                        Value="{StaticResource NoteCardFocusBorderBrush}"/>

                                <Setter TargetName="DeskTab"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Nova nota fixada no Desk. -->
        <Button x:Name="AddNoteButton"
                Width="30"
                Height="30"
                Margin="0,0,3,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{StaticResource DeskAddBackgroundBrush}"
                BorderBrush="{StaticResource DeskAddBorderBrush}"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                Command="{Binding CreateNoteCommand}"
                ToolTip="Nova nota no Desk"
                AutomationProperties.Name="Criar nota no Desk"
                AutomationProperties.HelpText="Cria uma nota fixada e abre o editor.">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="AddCircle"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="1"/>

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="AddCircle"
                                    Property="Fill"
                                    Value="{StaticResource DeskAddHoverBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <TextBlock Text="+"
                       Margin="0,-2,0,0"
                       FontSize="19"
                       FontWeight="Medium"
                       Foreground="{StaticResource DeskAddGlyphBrush}"
                       IsHitTestVisible="False"/>
        </Button>
    </Grid>
</Window>
