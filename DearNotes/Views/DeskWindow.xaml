<Window x:Class="DearNotes.Views.DeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DearNotes.Views.Converters"
        Title="DearNotes — Desk"
        Width="40"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Loaded="Window_Loaded"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <converters:TabLabelConverter x:Key="TabLabel"/>
    </Window.Resources>

    <!-- O fundo transparente ainda recebe o mouse: a faixa inteira funciona
         como zona de proximidade para abrir o leque. -->
    <Grid x:Name="DeskRoot"
          Background="Transparent"
          KeyboardNavigation.TabNavigation="Cycle">

        <!-- Leque: cartas sobrepostas como telhas; em repouso só a aba fica visível. -->
        <ItemsControl x:Name="FanCards"
                      ItemsSource="{Binding DeskNotes}"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Focusable="False"
                      KeyboardNavigation.TabIndex="1"
                      ClipToBounds="False">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="False"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="ClipToBounds" Value="False"/>

                    <EventSetter Event="Loaded"
                                 Handler="NoteContainer_Loaded"/>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="NoteCard"
                            Background="{Binding Color}"
                            CornerRadius="12"
                            BorderBrush="{StaticResource NoteCardBorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Focusable="True"
                            FocusVisualStyle="{x:Null}"
                            KeyDown="NoteCard_KeyDown"
                            MouseLeftButtonDown="NoteCard_MouseLeftButtonDown"
                            GotKeyboardFocus="NoteCard_KeyboardFocusChanged"
                            LostKeyboardFocus="NoteCard_KeyboardFocusChanged"
                            AutomationProperties.Name="{Binding Title}"
                            AutomationProperties.HelpText="Pressione Enter para abrir a nota e Escape para recolher o Desk.">

                        <!-- Deslocamento da carta escolhida, conduzido pelo DeskFanAnimator. -->
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>

                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource ShadowColor}"
                                              Direction="270"
                                              BlurRadius="14"
                                              ShadowDepth="3"
                                              Opacity="0.18"/>
                        </Border.Effect>

                        <DockPanel LastChildFill="True">

                            <!-- Aba vertical com o nome da nota, voltada para a borda da tela. -->
                            <Grid x:Name="NoteTabColumn"
                                  DockPanel.Dock="Left"
                                  Width="34"
                                  ClipToBounds="True">

                                <Line x:Name="NoteTabDivider"
                                      X1="0.5"
                                      X2="0.5"
                                      Y1="0"
                                      Y2="{Binding ActualHeight,
                                                   ElementName=NoteTabColumn}"
                                      Margin="0,10"
                                      HorizontalAlignment="Right"
                                      Stroke="{StaticResource NoteTabDividerBrush}"
                                      StrokeThickness="1"
                                      StrokeDashArray="3 3"/>

                                <TextBlock Width="72"
                                           Margin="0,12,0,0"
                                           Text="{Binding Title,
                                                          Converter={StaticResource TabLabel}}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NoteTabTitleBrush}"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           IsHitTestVisible="False">

                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Grid>

                            <!-- Corpo da nota: título e texto, revelados quando a carta sai do baralho. -->
                            <Grid Margin="14,13,16,14"
                                  ClipToBounds="True">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextStrongBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,7"/>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Content}"
                                           FontSize="12.5"
                                           LineHeight="18"
                                           Foreground="{StaticResource NotePreviewTextBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsOnRight,
                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="False">

                            <Setter TargetName="NoteTabColumn"
                                    Property="DockPanel.Dock"
                                    Value="Right"/>

                            <Setter TargetName="NoteTabDivider"
                                    Property="HorizontalAlignment"
                                    Value="Left"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsKeyboardFocused,
                                                     ElementName=NoteCard}"
                                     Value="True">

                            <Setter TargetName="NoteCard"
                                    Property="BorderBrush"
                                    Value="{StaticResource NoteCardFocusBorderBrush}"/>

                            <Setter TargetName="NoteCard"
                                    Property="BorderThickness"
                                    Value="2"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Baralho recolhido: uma pílula na cor de cada nota fixada. -->
        <Grid x:Name="TabDeck"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Background="Transparent"
              Cursor="Hand"
              Focusable="True"
              FocusVisualStyle="{x:Null}"
              KeyDown="DeskHandle_KeyDown"
              MouseLeftButtonDown="DeskHandle_MouseLeftButtonDown"
              KeyboardNavigation.TabIndex="0"
              AutomationProperties.Name="Notas fixadas no Desk"
              AutomationProperties.HelpText="Aproxime o ponteiro para abrir o leque ou pressione Enter.">

            <Border Padding="4"
                    CornerRadius="7"
                    BorderThickness="1">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="{StaticResource DeskStripBackgroundBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{StaticResource DeskStripBorderBrush}"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems,
                                                         ElementName=NoteTabs}"
                                         Value="False">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsMouseOver,
                                                         ElementName=TabDeck}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource DeskStripHoverBackgroundBrush}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsKeyboardFocused,
                                                         ElementName=TabDeck}"
                                         Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{StaticResource NoteCardFocusBorderBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ItemsControl x:Name="NoteTabs"
                              ItemsSource="{Binding DeskNotes}"
                              Focusable="False"
                              IsHitTestVisible="False">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="6"
                                    Height="20"
                                    Margin="0,2"
                                    Background="{Binding Color}"
                                    CornerRadius="3"
                                    BorderBrush="{StaticResource DeskPillBorderBrush}"
                                    BorderThickness="1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- Nova nota fixada no Desk, logo abaixo do baralho aberto. -->
        <Button x:Name="AddNoteButton"
                Width="26"
                Height="26"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Background="{StaticResource DeskAddBackgroundBrush}"
                BorderBrush="{StaticResource DeskAddBorderBrush}"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                KeyboardNavigation.TabIndex="2"
                Command="{Binding CreateNoteCommand}"
                ToolTip="Nova nota no Desk"
                AutomationProperties.Name="Criar nota no Desk"
                AutomationProperties.HelpText="Cria uma nota fixada e abre o editor.">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.Effect>
                            <DropShadowEffect Color="{StaticResource ShadowColor}"
                                              Direction="270"
                                              BlurRadius="8"
                                              ShadowDepth="1"
                                              Opacity="0.18"/>
                        </Grid.Effect>

                        <Ellipse x:Name="AddCircle"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="1"/>

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="AddCircle"
                                    Property="Fill"
                                    Value="{StaticResource DeskAddHoverBackgroundBrush}"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="AddCircle"
                                    Property="Stroke"
                                    Value="{StaticResource NoteCardFocusBorderBrush}"/>
                            <Setter TargetName="AddCircle"
                                    Property="StrokeThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <TextBlock Text="+"
                       Margin="0,-2,0,0"
                       FontSize="17"
                       FontWeight="Medium"
                       Foreground="{StaticResource DeskAddGlyphBrush}"
                       IsHitTestVisible="False"/>
        </Button>
    </Grid>
</Window>
