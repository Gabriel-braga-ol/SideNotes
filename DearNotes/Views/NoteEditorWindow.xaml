<Window x:Class="DearNotes.Views.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DearNotes.Views.Converters"
        Title="{Binding OpenedNote.Title}"
        Width="420"
        Height="470"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:ShortDateConverter x:Key="ShortDate"/>
        <converters:RelativeTimeConverter x:Key="RelativeTime"/>
    </Window.Resources>

    <Grid Margin="14">

        <Border x:Name="EditorCard"
                DataContext="{Binding OpenedNote}"
                Background="{Binding Color}"
                CornerRadius="20"
                BorderBrush="{StaticResource EditorOutlineBrush}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">

            <Border.Effect>
                <DropShadowEffect Color="{StaticResource ShadowColor}"
                                  Direction="270"
                                  BlurRadius="28"
                                  ShadowDepth="9"
                                  Opacity="0.24"/>
            </Border.Effect>

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="EditorScale"
                                    ScaleX="1"
                                    ScaleY="1"/>
                    <TranslateTransform x:Name="EditorSlide"
                                        X="0"
                                        Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid Margin="22,16,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra de arraste, identidade e fechamento. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">

                            <TextBlock Text="⠿"
                                       Margin="0,-1,8,0"
                                       FontSize="13"
                                       Foreground="{StaticResource EditorHeaderTextBrush}"/>

                            <TextBlock Text="DearNotes"
                                       FontSize="11"
                                       Foreground="{StaticResource EditorHeaderTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            AutomationProperties.Name="Fechar nota"
                            Command="{Binding DataContext.CloseOpenedNoteCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="CloseSurface"
                                      Background="Transparent"
                                      RenderTransformOrigin="0.5,0.5">

                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>

                                    <Ellipse x:Name="CloseHover"
                                             Fill="Transparent"/>

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Grid>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseHover"
                                                Property="Fill"
                                                Value="{StaticResource ChipHoverBrush}"/>

                                        <Setter TargetName="CloseSurface"
                                                Property="Opacity"
                                                Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="✕"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"/>
                    </Button>
                </Grid>

                <TextBox x:Name="TitleBox"
                         Grid.Row="1"
                         Text="{Binding Title,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextStrongBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0,12,0,14"
                         MaxHeight="96"
                         TextWrapping="Wrap"
                         SelectionBrush="{StaticResource EditorSelectionBrush}"
                         VerticalScrollBarVisibility="Hidden"
                         HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Título da nota"/>

                <Border Grid.Row="2"
                        Height="1"
                        Margin="0,0,0,14"
                        Background="{StaticResource EditorDividerBrush}"/>

                <TextBox x:Name="ContentBox"
                         Grid.Row="3"
                         Text="{Binding Content,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         SelectionBrush="{StaticResource EditorSelectionBrush}"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Conteúdo da nota"/>

                <!-- Rodapé com o estado do salvamento automático. -->
                <Grid Grid.Row="4"
                      Margin="0,14,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               FontSize="11"
                               Foreground="{StaticResource EditorMutedTextBrush}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="Atualizada em "/>
                        <Run Text="{Binding UpdatedAt,
                                           Converter={StaticResource ShortDate},
                                           Mode=OneWay}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding UpdatedAt,
                                           Converter={StaticResource RelativeTime},
                                           Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Grid.Column="1"
                               Text="Salva automaticamente"
                               FontSize="11"
                               Foreground="{StaticResource EditorMutedTextBrush}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
