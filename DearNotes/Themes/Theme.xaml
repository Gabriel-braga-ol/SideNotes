<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores de papel: usadas por mais de uma janela ou que representam a identidade do app. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#31544B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#426B60"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#243F38"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E3A34"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="#242A28"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#343B37"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#687078"/>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#D5DADC"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8"/>

    <!-- Texto e contorno sobre a cor da nota, que vem dos dados. -->
    <SolidColorBrush x:Key="NoteTabTitleBrush" Color="#A6222826"/>
    <SolidColorBrush x:Key="NoteTabDividerBrush" Color="#30222826"/>
    <SolidColorBrush x:Key="NotePreviewTextBrush" Color="#C7242A28"/>
    <SolidColorBrush x:Key="NoteCardBorderBrush" Color="#20000000"/>
    <SolidColorBrush x:Key="NoteCardFocusBorderBrush" Color="#31544B"/>
    <SolidColorBrush x:Key="EditorHeaderTextBrush" Color="#80242A28"/>
    <SolidColorBrush x:Key="EditorOutlineBrush" Color="#24000000"/>
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Botão de fixar no Desk. -->
    <SolidColorBrush x:Key="PinBackgroundBrush" Color="#B3ECEDEF"/>
    <SolidColorBrush x:Key="PinHoverBackgroundBrush" Color="#E6ECEDEF"/>
    <SolidColorBrush x:Key="PinIconBrush" Color="#7D828A"/>
    <SolidColorBrush x:Key="PinIconActiveBrush" Color="#626870"/>

    <!-- Baralho recolhido, cartas e botão de nova nota do Desk. -->
    <SolidColorBrush x:Key="DeskStripBackgroundBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="DeskStripHoverBackgroundBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="DeskStripBorderBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="DeskPillBorderBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="DeskAddBackgroundBrush" Color="#D9F4F4F6"/>
    <SolidColorBrush x:Key="DeskAddHoverBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="DeskAddBorderBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="DeskAddGlyphBrush" Color="#FF4A5058"/>

    <!-- Janela principal: superfície creme, cartões claros e textos quentes. -->
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#F4EDE1"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E5DBCB"/>
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#2B2923"/>
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#4B463C"/>
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#867D6E"/>

    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#FBF7EF"/>
    <SolidColorBrush x:Key="EditorSurfaceBorderBrush" Color="#EEE6D9"/>

    <SolidColorBrush x:Key="SearchFieldBrush" Color="#EAE1D2"/>
    <SolidColorBrush x:Key="SearchIconBrush" Color="#8A8173"/>
    <SolidColorBrush x:Key="ChipHoverBrush" Color="#E5DBCB"/>
    <SolidColorBrush x:Key="ChipSelectedBrush" Color="#FDFAF4"/>
    <SolidColorBrush x:Key="ChipSelectedBorderBrush" Color="#DCD1BF"/>

    <SolidColorBrush x:Key="ActionPillBrush" Color="#ECE3D4"/>
    <SolidColorBrush x:Key="ActionPillHoverBrush" Color="#E0D6C4"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#A64B42"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#F2DDD7"/>

    <SolidColorBrush x:Key="RowHoverBrush" Color="#EFE6D7"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#FDFAF4"/>
    <SolidColorBrush x:Key="RowSelectedBorderBrush" Color="#DED3C1"/>
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E9E0D1"/>

    <SolidColorBrush x:Key="WindowControlGlyphBrush" Color="#756D5F"/>
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#EAE1D2"/>
    <SolidColorBrush x:Key="WindowCloseHoverBrush" Color="#C15A4E"/>

    <SolidColorBrush x:Key="EditorTextBrush" Color="#2C2A24"/>
    <SolidColorBrush x:Key="EditorMutedTextBrush" Color="#7C7263"/>
    <SolidColorBrush x:Key="EditorDividerBrush" Color="#2E2C2A24"/>
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="#402C2A24"/>
    <SolidColorBrush x:Key="EmptyStateIconBrush" Color="#E9E0D1"/>

</ResourceDictionary>
